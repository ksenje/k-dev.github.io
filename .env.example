# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# Uploads and the SQLite database live outside the frontend bundle.
STORAGE_DIR=./storage
DATABASE_FILE=./storage/app.db
FRONTEND_DIST=./dist

# ── Admin auth ────────────────────────────────────────────────────────────
# Generate with: npm run hash -- "your password"
ADMIN_PASSWORD_HASH=
# Development only, ignored when the hash above is set.
ADMIN_PASSWORD=
SESSION_TTL_HOURS=12
SECURE_COOKIES=false
# Enable only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# ── Telegram ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Numeric Telegram id of the only account allowed to control the catalog.
TELEGRAM_ADMIN_ID=
# Any long random string; Telegram sends it back in the webhook header.
TELEGRAM_WEBHOOK_SECRET=
# Public https endpoint of this server, e.g. https://example.com/api/telegram/webhook
TELEGRAM_WEBHOOK_URL=

# ── Limits ────────────────────────────────────────────────────────────────
MAX_AUDIO_BYTES=26214400
MAX_COVER_BYTES=4194304
MAX_JSON_BYTES=262144
REQUEST_TIMEOUT_MS=30000

# ── Rate limits (per window, per IP unless authenticated) ─────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PUBLIC=240
RATE_LIMIT_MEDIA=600
RATE_LIMIT_ADMIN=300
RATE_LIMIT_UPLOAD=30
RATE_LIMIT_LOGIN=8

# ── Misc ──────────────────────────────────────────────────────────────────
# Extra allowed origins, comma separated. Same origin is always allowed.
CORS_ORIGINS=
AUDIT_RETENTION_DAYS=30